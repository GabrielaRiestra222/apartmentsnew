# Copy this file to .env and fill in your values
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost 127.0.0.1 .vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app http://localhost:5173 http://127.0.0.1:5173 http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 http://localhost:3000

# Only required when DEBUG=False
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Optional bootstrap for temporary Vercel SQLite demos only
USE_SQLITE=False
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=

# Production media storage for Vercel/serverless.
# Recommended: Cloudflare R2, AWS S3, or Supabase S3-compatible storage.
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
